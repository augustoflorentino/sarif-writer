root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = space
indent_size = 4

[*.{json,yml,cff}]
indent_style = space
indent_size = 2

[*.{sh,py}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
